// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role{
USER
ADMIN
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum UploadStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model UploadedChunk {
  id              String        @id @default(uuid())
  sessionId       String
  session         UploadSession @relation(fields: [sessionId], references: [id])
  chunkIndex      Int
  checksum        String
  createdAt       DateTime      @default(now())

  @@unique([sessionId, chunkIndex])
}

model UploadSession {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  fileName     String
  fileSize     BigInt
  chunkSize    Int
  totalChunks  Int
  status       UploadStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  uploadedChunk UploadedChunk[]
  finalChecksum String?
  mergedKey     String?
  isMerged   Boolean    @default(false)
  title         String?
  description   String?
}



model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  uploadSessions UploadSession[]
  playbackProgresses PlaybackProgress[]
}

enum ProcessingJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  DEAD_LETTERED
}

model ProcessingJob {
  id             String              @id @default(uuid())
  bullJobId      String              @unique
  videoId        String
  status         ProcessingJobStatus @default(QUEUED)
  attemptsMade   Int                 @default(0)
  lastError      String?
  deadLetteredAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PlaybackProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  videoId         String
  positionSeconds Float
  durationSeconds Float?
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userId, videoId])
}
